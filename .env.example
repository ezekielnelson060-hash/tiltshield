# Supabase (optional for local demo — assessment works without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave (primary payments)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
# Amount in major units (default 29000 NGN)
FLUTTERWAVE_AMOUNT=29000
FLUTTERWAVE_CURRENCY=NGN

# Stripe (optional)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_LIFETIME=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
